# Local development (npm run db:dev + npm run dev). On the server these come from
# husken/workshop/apper/apper.json (env + secrets), never from a file in the repo.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5471/postgres?sslmode=disable
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3520
NEXT_PUBLIC_BASE_URL=http://localhost:3520
HAI_SUPERADMIN=oyvind@zoney.no
# HAI_MILJO=production   (schema "app"; anything else uses "dev")
# HAI_VARSLE=a@example.com,b@example.com   (optional: e-mail the organisers on each signup)
# SLACK_SIGNING_SECRET=   (optional: the /summit-signups slash command)
# Mail: without EPOST_SOCKET the e-mail is written to the log instead of sent.
# EPOST_SOCKET=  EPOST_FRA=summit@post.homborsundai.no  DKIM_DOMENE=post.homborsundai.no  DKIM_VELGER=  DKIM_NOKKEL=
